rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra para a coleção 'cores'
    // Permite que um usuário autenticado leia apenas o seu próprio documento (cujo ID é igual ao seu UID)
    match /cores/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId; // Opcional, permite salvar se necessário
    }
  }
}
